# phục chế {vì:là}.env sau điền (chớ Nộp bài.env)
#
# thượng tuyến danh sách (ECS bên trên theo như trình tự chấp hành):
# 1. a lý vân lập hồ sơ đài điều khiển → {vì:là} api.youyisida.com tăng thêm tử vực tên tiếp nhập
# 2. cp.env.example.env cũng điền phía dưới tất điền hạng
# 3. npm install --production && pm2 start server.js --name yysd-api
# 4. nginx phản thay api.youyisida.com → 127.0.0.1:3000 (gặp deploy/nginx-api.conf)
# 5. certbot --nginx -d api.youyisida.com
# 6. bash deploy/diagnose-api.sh
# 7. trình duyệt mở ra https://youyisida.com/login.html Kiểm tra Mã xác thực Đăng nhập

PORT=3000
# tất điền: openssl rand -hex 32
JWT_SECRET=

# tất điền (Đăng nhập Mã xác thực): a lý vân RAM → AccessKey + tin nhắn đài điều khiển kí tên / khuôn mô hình
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME= Hợp Phì YYSD Giáo dục cố vấn
SMS_TEMPLATE_CODE=SMS_508955166

# tất điền: lối vào vực tên (dấu phẩy ngăn; tử vực tên do Server đang tức thì cho đi *.youyisida.com)
CORS_ORIGINS=https://youyisida.com,https://www.youyisida.com

# bình đài vượt qua quản Số điện thoại (dấu phẩy ngăn, có thể tiến platform.html; 15901754473 dấu hiệu bên trong cũng sẽ cưỡng chế giữ lại)
ADMIN_PHONES=15901754473,15609693333

# trạm điểm[web] chủ vực (phục vụ khách hàng tiến vào kết nối dùng)
SITE_HOST=youyisida.com

# có thể chọn (Nghe sâu / Nói cho điểm / AI Trợ giảng IELTS; không điền tức thì AI tiếp lời Quay lại 503)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# AI Trợ giảng IELTS Âm thanh (có thể chọn)
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Neil
# mỗi ngày Từ vựng phối đồ (có thể chọn; không điền tức thì dùng cam chịu wanx2.1-t2i-turbo)
DASHSCOPE_IMG_MODEL=wanx2.1-t2i-turbo

# Cổng giáo viên Mã khóa đăng ký (tất điền, vẻn vẹn nắm giữ Mã khóa người có thể Đăng ký Giáo viên tài khoản)
TEACHER_REGISTER_KEY=
