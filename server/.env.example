# nhân bản làm .env hoàng hậu điền vào biểu mẫu(đừng nộp .env)
#
# lên mạng danh sách mục(ECS dùng trong | nhấn trình tự thực hiện): 
# 1. Ali nói đưa vào hồ sơ bàn điều khiển → là api.youyisida.com thêm trường con tên truy cập
# 2. cp .env.example .env và điền vào biểu mẫu bên dưới nhất định lấp hoặc nhồi sau cổ
# 3. npm install --production && pm2 start server.js --name yysd-api
# 4. nginx ngược thay thế api.youyisida.com → 127.0.0.1:3000(thấy deploy/nginx-api.conf)
# 5. certbot --nginx -d api.youyisida.com
# 6. bash deploy/diagnose-api.sh
# 7. trình duyệt mở https://youyisida.com/login.html kiểm tra mã xác minh đăng ký

PORT=3000
# nhất định lấp hoặc nhồi: openssl rand -hex 32
JWT_SECRET=

# nhất định lấp hoặc nhồi(đăng ký mã xác minh): Ali nói RAM → AccessKey + tin nhắn văn bản bàn điều khiển ký tên/mẫu
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=Hợp Phì xuất sắc lợi ích suy nghĩ đạt tới giáo dục tư vấn
SMS_TEMPLATE_CODE=SMS_508955166

# nhất định lấp hoặc nhồi: phía trước tên miền(dấu phẩy chia cắt; trường con tên theo phục vụ ngay thẳng nhưng cho qua *.youyisida.com)
CORS_ORIGINS=https://youyisida.com,https://www.youyisida.com

# nền tảng vượt quá biến thể của điện thoại di động gầm(dấu phẩy chia cắt, có thể tiến lên platform.html; 15901754473 mã bên trong cũng có thể ép buộc giữ)
ADMIN_PHONES=15901754473,15609693333

# trang web chủ lĩnh vực(dịch vụ khách hàng đi vào liên kết sử dụng)
SITE_HOST=youyisida.com

# có sẵn(tinh chất cười / lời nói thông thường chấm điểm / AI IELTS giáo viên; không lấp hoặc nhồi nhưng AI giao diện trở về 503)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# AI IELTS giáo viên âm thanh lời nói(có sẵn)
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Neil
# hàng ngày từ kết hợp sơ đồ(có sẵn; không lấp hoặc nhồi nhưng sử dụng đồng ý ngầm wanx2.1-t2i-turbo)
DASHSCOPE_IMG_MODEL=wanx2.1-t2i-turbo

# giáo viên cuối đăng ký khóa(nhất định lấp hoặc nhồi, hầu như nắm giữ khóa người mà có thể đăng ký giáo viên số tài khoản)
TEACHER_REGISTER_KEY=
