{
  "name": "ielts-vi",
  "version": "1.0.0",
  "description": "Không gian tự học tiếng Việt dành cho người luyện IELTS Academic. Đề bài, đáp án và ví dụ tiếng Anh được giữ nguyên. Bản GitHub Pages dùng tài liệu tĩnh; không gửi bài làm, thông tin đăng nhập hoặc bản thu âm tới máy chủ.",
  "devDependencies": {
    "jsdom": "26.1.0",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "puppeteer-core": "24.40.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "python3 tools/build.py",
    "test": "node --experimental-test-coverage --test-coverage-include=\"assets/*.mjs\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test tests/*.test.mjs",
    "pdf": "node tools/pdf.mjs",
    "smoke": "node tools/smoke.mjs",
    "audit:pages": "node tools/lighthouse.mjs"
  }
}
