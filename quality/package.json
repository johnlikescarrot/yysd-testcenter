{
  "name": "yysd-ielts-vi-quality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "pdf": "node make-pdfs.mjs",
    "test": "c8 --all --allow-external --src ../ielts-vi/assets --include '**/ielts-vi/assets/*.js' --100 --per-file --reporter=text --reporter=lcov node --test test/*.test.mjs",
    "test:browser": "node browser-test.mjs",
    "lighthouse": "node audit.mjs",
    "audio": "node make-audio.mjs",
    "deck": "node make-deck.mjs",
    "reading": "node import-reading.mjs",
    "test:portal": "node --test portal-test.mjs"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@echogarden/flite-wasi": "0.1.1",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@sparticuz/chromium": "153.0.0",
    "acorn": "8.19.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "lighthouse": "13.6.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.20.2",
    "puppeteer-core": "25.18.1"
  }
}
