{
  "ci": {
    "collect": {
      "staticDistDir": "./vi",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "canonical",
          "hreflang",
          "plugins"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*404\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": "off",
            "is-crawlable": "off",
            "color-contrast": [
              "error",
              {
                "minScore": 1
              }
            ],
            "heading-order": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "color-contrast": [
              "error",
              {
                "minScore": 1
              }
            ],
            "heading-order": [
              "error",
              {
                "minScore": 1
              }
            ],
            "image-alt": [
              "error",
              {
                "minScore": 1
              }
            ],
            "is-crawlable": [
              "error",
              {
                "minScore": 1
              }
            ],
            "meta-description": [
              "error",
              {
                "minScore": 1
              }
            ],
            "link-text": [
              "error",
              {
                "minScore": 1
              }
            ],
            "button-name": [
              "error",
              {
                "minScore": 1
              }
            ],
            "label": [
              "error",
              {
                "minScore": 1
              }
            ],
            "document-title": [
              "error",
              {
                "minScore": 1
              }
            ],
            "html-has-lang": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
