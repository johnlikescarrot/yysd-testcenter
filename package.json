{
  "name": "yysd-testcenter",
  "private": true,
  "version": "2.0.0",
  "description": "Trung tâm luyện thi IELTS YYSD — giao diện tiếng Việt, gamification kiểu Duolingo",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=assets/js/duolingo-core.js --test-coverage-include=assets/js/i18n-vi.js --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/*.test.mjs",
    "lint": "node scripts/check_vi_locale.mjs",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}